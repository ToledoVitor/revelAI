{
  "expo": {
    "name": "RevelAI",
    "slug": "revelai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "revelai",
    "platforms": ["ios", "android", "web"],
    "plugins": ["expo-router", "expo-camera", "expo-secure-store", "expo-font"],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}
