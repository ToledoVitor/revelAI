# Names and placeholders only. Leave all Roboflow settings unset for offline demo mode.
NODE_ENV=<development|test|production>
HOST=<loopback-host>
PORT=<port>
PUBLIC_BASE_URL=<http-or-https-public-base-url>
DATA_DIR=<local-data-directory>
MEDIA_DIR=<local-media-directory>
DATABASE_PATH=<sqlite-database-path>

# Required only for an intentional non-loopback unauthenticated MVP bind.
ALLOW_UNAUTHENTICATED_PUBLIC=<true>

# Real Workflow experiments require this complete server-only tuple. Never put
# an actual key, receipt, identity, path, payload, or media data in this file.
ROBOFLOW_API_URL=<https-provider-url-or-keyless-loopback-http-url>
ROBOFLOW_API_KEY=<server-secret>
ROBOFLOW_WORKSPACE_ID=<workspace-id>
ROBOFLOW_WORKFLOW_VERSION=<1.0.0>
ROBOFLOW_WALL_PASS_WORKFLOW_ID=<revelai-wall-pass-geometry-v1>
ROBOFLOW_WALL_PASS_MODEL_BUNDLE_ID=<wall-pass-model-bundle-id>
ROBOFLOW_FREE_WORKFLOW_ID=<revelai-free-training-v1>
ROBOFLOW_FREE_MODEL_BUNDLE_ID=<free-training-model-bundle-id>
