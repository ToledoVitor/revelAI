{
  "name": "@revelai/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/clean-production-dist.mjs && tsc --project tsconfig.build.json && pnpm run check:production-dist",
    "build:workspace": "pnpm --filter @revelai/api... run build",
    "check:production-dist": "node scripts/assert-production-dist.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node scripts/assert-vitest-worker-config.mjs && vitest run --config vitest.config.mjs",
    "test:operability": "pnpm run build:workspace && vitest run src/http/operability-routes.test.ts src/startup.test.ts",
    "openapi:generate": "pnpm run build:workspace && node scripts/generate-openapi.mjs",
    "openapi:check": "pnpm run build:workspace && node scripts/generate-openapi.mjs --check",
    "benchmark:roboflow": "pnpm run build:workspace && node scripts/benchmark-roboflow-wall-pass.mjs",
    "demo:start": "pnpm run build:workspace && node scripts/start-local-demo.mjs",
    "demo:smoke": "pnpm run build:workspace && node scripts/start-local-demo.mjs --check && node scripts/local-demo-check-regression.mjs",
    "operator:receipt-import": "pnpm run build:workspace && node scripts/import-benchmark-receipt.mjs",
    "operator:receipt-smoke": "pnpm run build:workspace && node scripts/operator-receipt-smoke.mjs"
  },
  "dependencies": {
    "@fastify/busboy": "3.2.2",
    "@revelai/config": "workspace:*",
    "@revelai/contracts": "workspace:*",
    "@revelai/domain": "workspace:*",
    "@revelai/vision": "workspace:*",
    "better-sqlite3": "13.0.3",
    "fastify": "5.12.1",
    "jpeg-js": "0.4.4",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
