{
  "name": "@revelai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/verify-design-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/verify-design-assets.mjs",
    "build": "pnpm --filter @revelai/design-system run build && tsc --project tsconfig.json && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "node scripts/ensure-chromium.mjs",
    "test": "node --test scripts/ensure-chromium.check.mjs scripts/production-router-build.check.mjs scripts/production-router-clean-dist.check.mjs scripts/demo-media-fixtures.test.mjs && vitest run --config vitest.config.ts && pnpm run test:visual:structural:run",
    "test:ensure-chromium": "node --test scripts/ensure-chromium.check.mjs",
    "test:production-router:clean": "node --test scripts/production-router-clean-dist.check.mjs",
    "test:provisioning": "node --test scripts/playwright-provisioning.check.mjs",
    "pretest:visual": "node scripts/ensure-chromium.mjs",
    "test:visual": "pnpm run test:visual:structural:run",
    "pretest:visual:structural": "node scripts/ensure-chromium.mjs",
    "test:visual:structural": "pnpm run test:visual:structural:run",
    "test:visual:structural:run": "node scripts/run-playwright.mjs --revelai-visual-mode structural",
    "build:production-router": "node scripts/build-production-router-artifact.mjs",
    "test:production-router": "node scripts/run-playwright.mjs --revelai-visual-mode structural --config playwright.production.config.ts",
    "pretest:demo:e2e": "node scripts/ensure-chromium.mjs",
    "test:demo:e2e": "pnpm --filter @revelai/api run build:workspace && pnpm run build && pnpm exec playwright test --config playwright.demo.config.ts",
    "test:demo:e2e:smoke": "pnpm --filter @revelai/api run build:workspace && pnpm run build && pnpm exec playwright test --config playwright.demo.smoke.config.ts",
    "pretest:visual:darwin": "node scripts/ensure-chromium.mjs",
    "test:visual:darwin": "node scripts/run-playwright.mjs --revelai-visual-mode darwin",
    "test:visual:canonical": "node scripts/run-playwright.mjs --revelai-visual-mode canonical"
  },
  "dependencies": {
    "@fontsource/arimo": "5.3.0",
    "@fontsource/bebas-neue": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@revelai/contracts": "workspace:*",
    "@revelai/design-system": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "26.1.0",
    "msw": "2.12.4",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
