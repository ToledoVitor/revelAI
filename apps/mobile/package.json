{
  "name": "@revelai/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "assets:verify": "pnpm --workspace-root verify:design-assets",
    "prepare:runtime": "pnpm --filter @revelai/contracts run build && pnpm --filter @revelai/design-system run build && pnpm run assets:verify",
    "predev": "pnpm run prepare:runtime",
    "dev": "expo start",
    "preexport:web": "pnpm run prepare:runtime",
    "export:web": "expo export --platform web",
    "preexport:ios": "pnpm run prepare:runtime",
    "export:ios": "expo export --platform ios",
    "lint": "eslint app src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "pretest": "pnpm run prepare:runtime",
    "test": "jest --runInBand",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/bebas-neue": "0.4.1",
    "@expo/metro-runtime": "~6.1.2",
    "@revelai/contracts": "workspace:*",
    "@revelai/design-system": "workspace:*",
    "@tanstack/react-query": "5.90.20",
    "expo": "54.0.18",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.10",
    "expo-document-picker": "~14.0.7",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.19",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "phosphor-react-native": "2.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.4",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "expo-doctor": "1.20.4",
    "jest": "29.7.0",
    "jest-expo": "54.0.18",
    "react-test-renderer": "19.1.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@revelai/contracts$": "<rootDir>/../../packages/contracts/dist/index.js",
      "^@revelai/design-system$": "<rootDir>/../../packages/design-system/dist/index.js",
      "^phosphor-react-native$": "<rootDir>/node_modules/phosphor-react-native/lib/commonjs/index.js"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "react-native"
      ]
    }
  }
}
