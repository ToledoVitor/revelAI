{
  "name": "@revelai/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/verify-design-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/verify-design-assets.mjs",
    "build": "pnpm --filter @revelai/design-system run build && tsc --project tsconfig.json && vite build",
    "lint": "eslint src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts && pnpm run test:visual",
    "pretest:visual": "playwright install chromium",
    "test:visual": "playwright test"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@revelai/design-system": "workspace:*",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/pngjs": "6.0.5",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "26.1.0",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.4"
  }
}
