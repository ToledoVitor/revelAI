# Demo/local defaults. Copy to .env only when local overrides are needed.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
DATA_DIR=.revelai/data
MEDIA_DIR=.revelai/media
DATABASE_PATH=.revelai/data/revelai.sqlite

# Leave every Roboflow variable unset for demo mode. Configure all of them together
# through your secret manager for an experiment; the placeholder below is not a key.
# ROBOFLOW_API_KEY=<set-outside-version-control>
# ROBOFLOW_BASE_URL=https://<provider-host>
# ROBOFLOW_WORKSPACE_ID=<workspace-id>
# ROBOFLOW_WORKFLOW_ID=<workflow-id>
# ROBOFLOW_WORKFLOW_VERSION=<workflow-version>

# Required only for a deliberate non-loopback, unauthenticated MVP bind.
# ALLOW_UNAUTHENTICATED_PUBLIC=true
